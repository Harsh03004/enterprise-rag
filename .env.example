# Copy this file to .env before starting the local Compose stack.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=http://localhost:5173
SQLALCHEMY_ECHO=false

# LLM provider: ollama or gemini
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Required only for the production Compose file.
APP_DOMAIN=rag.example.com

# Local storage is simplest for development. For production, set STORAGE_BACKEND=s3
# and configure a private bucket and credentials in the deployment secret store.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional external Postgres connection for production deployment.
DATABASE_URL=
CONTAINER_DATABASE_URL=
POSTGRES_PASSWORD=postgres

# Admin-configurable estimated token rates default to zero until set in the UI.

# Celery worker processes. Each one may load the embedding and reranker models.
WORKER_CONCURRENCY=2

# CPU entailment model that checks answer sentences against their sources.
GROUNDING_MODEL=cross-encoder/nli-deberta-v3-xsmall
GROUNDING_MIN_ENTAILMENT=0.5

# OpenRouter (LLM_PROVIDER=openrouter). Free models end in ":free" and are rate limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Logging: json (one object per line, for log collectors) or text (readable locally).
LOG_FORMAT=json
LOG_LEVEL=INFO
